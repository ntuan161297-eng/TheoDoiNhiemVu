// REFERENCE ONLY, not loaded by Wrangler. Do not deploy before B1 approval.
// Merge only into the root config's previews block after creating a separate TEST DB.
// Keep top-level Production d1_databases absent. Never paste a Production UUID here.
{
  "previews": {
    "vars": { "APP_ENV": "preview" },
    "d1_databases": [{
      "binding": "DB",
      "database_name": "theodoinhiemvu-d1-test",
      "database_id": "REPLACE_WITH_D1_TEST_UUID",
      "migrations_dir": "cloudflare/d1/migrations"
    }],
    "r2_buckets": []
  }
}
