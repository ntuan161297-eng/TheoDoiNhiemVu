{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "theodoinhiemvu-d1-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-06",
  "send_metrics": false,
  "workers_dev": false,
  "vars": { "APP_ENV": "development" },
  // FAKE UUID. Use ONLY with --local or getPlatformProxy(remoteBindings:false).
  // This configuration is for DB tooling, not for serving/deploying the UI.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "theodoinhiemvu-b1-local",
    "database_id": "00000000-0000-4000-8000-000000000001",
    "migrations_dir": "cloudflare/d1/migrations",
    "remote": false
  }]
}
